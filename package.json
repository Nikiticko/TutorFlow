{
  "name": "tutorflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "server": "node --env-file-if-exists=.env server/index.js",
    "db:up": "docker compose --env-file /dev/null up -d --wait",
    "db:stop": "docker compose --env-file /dev/null stop",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
